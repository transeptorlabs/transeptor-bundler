{
  "name": "transeptor-bundler",
  "private": true,
  "version": "0.16.1",
  "description": "Transeptor is a high-performance, modular ERC-4337 bundler designed to make smart accounts scalable and usable on Ethereum",
  "author": {
    "name": "Transeptor Labs",
    "email": "info@transeptorlabs.io",
    "url": "https://transeptorlabs.io"
  },
  "license": "GNU",
  "homepage": "https://github.com/transeptorlabs/transeptor-bundler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transeptorlabs/transeptor-bundler.git"
  },
  "bugs": {
    "url": "https://github.com/transeptorlabs/transeptor-bundler/issues"
  },
  "type": "module",
  "bin": {
    "transeptor": "./dist/cli.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "ls:cmd": "tsx ./src/cli.ts --help",
    "type-check": "tsc --noEmit",
    "build": "yarn type-check && rm -rf dist && pkgroll --target=node22.23.4 --minify",
    "build:contracts": "cd contracts && forge build",
    "build:typedocs": "typedoc",
    "dev": "tsx watch ./src/cli.ts --httpApi web3,eth,debug --txMode base | pino-pretty",
    "dev:unsafe": "tsx watch ./src/cli.ts --httpApi web3,eth,debug --txMode base --unsafe | pino-pretty",
    "dev:metrics": "tsx watch ./src/cli.ts --httpApi web3,eth,debug --metrics --txMode base | pino-pretty",
    "dev:auditTrail": "tsx watch ./src/cli.ts --httpApi web3,eth,debug --txMode base --auditTrail true | pino-pretty",
    "start": "tsx ./src/cli.ts --httpApi web3,eth,debug --txMode base | pino-pretty",
    "start:prod": "yarn build && node dist/cli.mjs --httpApi web3,eth,debug --txMode base | pino-pretty",
    "test": "yarn type-check && vitest run --config ./vitest.config.ts --coverage",
    "test:dev": "vitest --config ./vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "send-op": "tsx ./e2e/send-userop.e2e.ts | pino-pretty",
    "print-dev_accounts": "tsx ./e2e/print-dev-accounts.ts",
    "///cK": "________________________DOCKER CONTAINERS______________________________",
    "start:eth-dev": "./eth-node",
    "build:image": "docker build -t bundler-typescript:v-local .",
    "start:image": "docker compose up -d bundler-typescript-local",
    "stop:image": "docker compose down",
    "influxdb": "docker compose up influxdb",
    "grafana": "docker compose up grafana",
    "run:audit:all": "yarn npm audit --all --recursive",
    "run:audit:ci": "yarn npm audit --all --recursive --no-deprecations",
    "run:audit": "yarn npm audit"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@influxdata/influxdb-client": "1.33.2",
    "@libp2p/ping": "3.1.17",
    "@libp2p/tcp": "11.0.32",
    "@multiformats/multiaddr": "13.0.3",
    "async-mutex": "0.4.0",
    "commander": "10.0.1",
    "cors": "2.8.6",
    "dotenv": "16.0.3",
    "ethers": "6.17.0",
    "express": "4.22.3",
    "helmet": "7.2.0",
    "libp2p": "3.5.1",
    "os-utils": "0.0.14",
    "pino": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/os-utils": "0.0.4",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-prettier": "5.5.7",
    "pino-pretty": "10.3.1",
    "pkgroll": "2.29.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typedoc": "0.26.11",
    "typescript": "5.3.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "resolutions": {
    "@babel/core@^7.23.9": "7.29.7",
    "@ungap/structured-clone@^1.0.0": "1.4.0",
    "@ungap/structured-clone@^1.2.0": "1.4.0",
    "ajv@^6.12.4": "6.15.0",
    "bn.js@^5.1.2": "5.2.5",
    "bn.js@^5.2.0": "5.2.5",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "brace-expansion@^2.0.2": "2.1.7",
    "browserslist@^4.24.0": "4.29.5",
    "fast-copy@^3.0.0": "3.1.0",
    "http-cache-semantics@^4.1.1": "4.3.0",
    "ip-address@^10.1.1": "10.7.5",
    "js-yaml@^4.1.0": "4.3.2",
    "linkify-it@^5.0.0": "5.0.2",
    "markdown-it@^14.1.0": "14.3.3",
    "minimatch@9.0.3": "9.0.9",
    "minimatch@^9.0.4": "9.0.9",
    "minimatch@^9.0.5": "9.0.9",
    "nanoid@^3.3.8": "3.3.20",
    "nanoid@^3.3.11": "3.3.20",
    "node-gyp@npm:latest": "13.1.0",
    "pbkdf2@^3.0.17": "3.1.7",
    "picomatch@^4.0.2": "4.0.7",
    "picomatch@^4.0.3": "4.0.7",
    "picomatch@^4.0.4": "4.0.7",
    "proxy-addr@~2.0.7": "2.0.8",
    "postcss@^8.5.1": "8.5.32",
    "postcss@^8.5.8": "8.5.32",
    "socks@^2.8.3": "2.8.10",
    "source-map-js@^1.2.0": "1.2.2",
    "source-map-js@^1.2.1": "1.2.2",
    "tar@^7.4.3": "7.5.22",
    "ws@8.17.1": "8.22.0",
    "yaml@^2.5.1": "2.9.1"
  },
  "packageManager": "yarn@4.7.0",
  "engines": {
    "node": ">=22.23.4"
  }
}
